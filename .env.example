# Voorbeeld. Dit bestand bevat GEEN echte sleutels en mag in de repository staan.
# De echte waarden zet je bij je host:
#   Netlify:    Site configuration -> Environment variables
#   Cloudflare: Settings -> Variables and Secrets
#
# Sleutel van De Lijn (kernopendata)
DELIJN_KEY=
# Sleutel van Aviationstack (gratis tier volstaat)
AVIATIONSTACK_KEY=
# Sleutel van TomTom voor reistijd met verkeer (optioneel, gratis tot 2500 opvragingen per dag)
TOMTOM_KEY=
